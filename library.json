{
  "name": "TeensyUSBAudioHost",
  "version": "0.1.0",
  "description": "USB Audio Class (UAC1/UAC2) host driver for class-compliant audio interfaces on the Teensy 4.x and 3.6 USB host port, as a USBHost_t36 driver with Teensy Audio Library input and output objects.",
  "keywords": ["teensy", "usb", "host", "audio", "uac2", "usbhost_t36", "isochronous"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mixedmode-fx/teensy-usb-audio-host.git"
  },
  "authors": [
    { "name": "MixedMode fX", "maintainer": true }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "teensy",
  "headers": ["USBAudioHost.h", "AudioEffectVST.h"],
  "examples": [
    { "name": "Passthrough", "base": "examples/Passthrough", "files": ["Passthrough.ino"] },
    { "name": "RecordToSD", "base": "examples/RecordToSD", "files": ["RecordToSD.ino"] },
    { "name": "Reverb", "base": "examples/Reverb", "files": ["Reverb.ino"] },
    { "name": "StereoDelay", "base": "examples/StereoDelay", "files": ["StereoDelay.ino"] },
    { "name": "Overdrive", "base": "examples/Overdrive", "files": ["Overdrive.ino"] },
    { "name": "Modulation", "base": "examples/Modulation", "files": ["Modulation.ino"] },
    {
      "name": "VSTHost",
      "base": "examples/VSTHost",
      "files": [
        "VSTHost.ino", "plugins.h", "plugins.cpp",
        "airwindows/README.md", "airwindows/LICENSE",
        "airwindows/Capacitor/Capacitor.h", "airwindows/Capacitor/Capacitor.cpp", "airwindows/Capacitor/CapacitorProc.cpp",
        "airwindows/Density/Density.h", "airwindows/Density/Density.cpp", "airwindows/Density/DensityProc.cpp",
        "airwindows/Pressure4/Pressure4.h", "airwindows/Pressure4/Pressure4.cpp", "airwindows/Pressure4/Pressure4Proc.cpp",
        "airwindows/Tape/Tape.h", "airwindows/Tape/Tape.cpp", "airwindows/Tape/TapeProc.cpp",
        "airwindows/Tremolo/Tremolo.h", "airwindows/Tremolo/Tremolo.cpp", "airwindows/Tremolo/TremoloProc.cpp"
      ]
    },
    {
      "name": "CumulusReverb",
      "base": "examples/CumulusReverb",
      "files": [
        "CumulusReverb.ino", "cumulus_reverb.h", "cumulus_reverb.cpp", "mutable_reverb.h",
        "clouds/README.md", "clouds/dsp/frame.h", "clouds/dsp/fx/fx_engine.h", "clouds/dsp/fx/reverb.h",
        "stmlib/LICENSE", "stmlib/stmlib.h", "stmlib/dsp/dsp.h", "stmlib/dsp/cosine_oscillator.h"
      ]
    }
  ],
  "export": {
    "exclude": [".github", ".pio", "test", "scripts", "platformio.ini", "Makefile"]
  }
}
