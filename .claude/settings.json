{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-checks.sh",
            "timeout": 600,
            "statusMessage": "Running the commit checks"
          }
        ]
      }
    ]
  }
}
